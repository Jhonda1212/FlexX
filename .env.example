# FLEX environment variables.
# Copy to .env.local for local development. Configure the same names in Vercel
# for Production and Preview with the values from the correct Supabase/Stripe projects.

# Public Supabase client config.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for older Supabase projects. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin key. Never expose this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Server secrets must never use NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public app origin used by Checkout success/cancel URLs.
NEXT_PUBLIC_APP_URL=

# Optional local-only demo mode. Keep false/empty for production.
# NEXT_PUBLIC_ENABLE_MOCKS=true
